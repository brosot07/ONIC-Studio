{
  "name": "onic-studio",
  "private": true,
  "version": "0.0.1",
  "description": "ONIC Studio — Instagram and merch design with an AI agent team, for ONIC Esports' Design department.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @onic/web",
    "build": "npm run build -w @onic/web",
    "preview": "npm run preview -w @onic/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vendor-skills": "node scripts/vendor-skills.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-xml-parser": "5.11.2",
    "globals": "17.13.0",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
